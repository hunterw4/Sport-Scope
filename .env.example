# Copy this file to .env and fill in real values. .env is gitignored — keep it that way.
#
# HISTORY: the original .env was committed to this repo and pushed to origin/main
# (commit 98ca847). Every value below was therefore public. Do not reuse the old
# credentials — issue new ones from each provider before running this app again.

# Sports data provider API key
SPORTS_API=

# NewsAPI key — https://newsapi.org
NEWS_API=

# Flask session-signing secret. Generate a fresh one:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DATA_SECRET_KEY=

# MySQL connection details
DATA_BASE_HOST=
DATA_BASE_USER=
DATA_BASE_PASSWORD=
